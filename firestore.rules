rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email in ["yakir.abramovich@gmail.com"];
    }

    match /Users/{userDocId} {
      allow read: if signedIn();
      allow create: if signedIn();
      // User docs are keyed by encoded email, so ownership is determined by stored userId field.
      allow update: if (signedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.email == request.auth.token.email
      )) || isAdmin();
      allow delete: if isAdmin();
    }

    match /Reports/{reportId} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    match /Admins/{adminDocId} {
      allow read, write: if isAdmin();
    }
  }
}
